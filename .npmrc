# No dependency in this project needs an install script: better-sqlite3 and
# sharp ship prebuilt binaries for Windows, macOS and Linux. npm would
# otherwise try to compile better-sqlite3 from source when installing from the
# lockfile (it ignores the package's "gypfile": false), which needs a C++
# toolchain. Explicit commands such as `npm run dev` and `npm test` still run.
ignore-scripts=true
