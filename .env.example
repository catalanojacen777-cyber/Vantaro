# ---------------------------------------------------------------------------
# Vantaro environment. Copy to .env.local (development) or set on your host.
# Anything left empty is treated as "not configured" and is never shown as
# if it were a real fact (price, refund terms, support address, operator).
# ---------------------------------------------------------------------------

# development | preview | production
# Only "production" allows search indexing and blocks simulated AI output.
VANTARO_ENV=development
# Absolute origin used for canonicals, sitemap, emails and share links.
SITE_URL=http://localhost:3000
# Long random string. Required in production (hashes IPs, signs nothing else).
APP_SECRET=
# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Set to false to keep a production deployment out of search engines.
VANTARO_ALLOW_INDEXING=true

# --- Database (SQLite file; needs a persistent disk in production) ---------
DATABASE_PATH=./data/vantaro.db

# --- AI provider (Anthropic Messages API) ---------------------------------
# Without a key: development/preview use clearly labeled placeholder output;
# production disables generation instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_MS=90000
# Comma-separated. Only list languages you have tested output quality in.
OUTPUT_LANGUAGES=English
# Max model calls running at once in this process.
JOB_CONCURRENCY=4

# --- Limits ----------------------------------------------------------------
LIMIT_ANON_GENERATIONS_PER_DAY=5
LIMIT_FREE_GENERATIONS_PER_DAY=25
LIMIT_FREE_STRATEGIES_PER_30_DAYS=1
LIMIT_FREE_PERSONAS=3
LIMIT_FREE_WORKSPACES=1
LIMIT_PAID_GENERATIONS_PER_DAY=150
LIMIT_PAID_STRATEGIES_PER_30_DAYS=10
LIMIT_PAID_PERSONAS=5
LIMIT_PAID_WORKSPACES=5

# --- Billing (Stripe Checkout, one-time payment) ---------------------------
# Purchase stays disabled until ALL of these are set. In production a test
# key (sk_test_) keeps purchase disabled.
PAID_PLAN_NAME=Vantaro Pro
# Price in minor units, e.g. 4900 = $49.00
PRICE_AMOUNT=
PRICE_CURRENCY=usd
REFUND_DAYS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
# Where contact-form messages are delivered (defaults to SUPPORT_EMAIL).
SUPPORT_INBOX=

# --- Operator facts (required before policies can go live) -----------------
OPERATOR_LEGAL_NAME=
OPERATOR_ADDRESS=
OPERATOR_JURISDICTION=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
# e.g. 2026-11-01
POLICIES_EFFECTIVE_DATE=
